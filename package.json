{
  "name": "jetgit",
  "displayName": "JetGit - IntelliJ IDEA Git Graph, Commit & Shelf",
  "publisher": "ziop",
  "description": "IntelliJ IDEA Git experience for VS Code & Cursor. Git graph visualization, IDEA-style commit panel with shelf/stash, branch management, cherry-pick, rebase, merge, 3-way merge conflict editor, nested git repo auto-discovery, hover action buttons, and full Chinese localization. The best JetBrains Git alternative.",
  "version": "0.5.1",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/wangpi26/jetbrains-git-graph"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "intellij",
    "jetbrains",
    "idea",
    "git graph",
    "commit",
    "shelf",
    "stash",
    "branch",
    "merge",
    "cherry-pick",
    "rebase",
    "git log",
    "diff",
    "3-way merge",
    "webstorm",
    "pycharm",
    "goland",
    "rider",
    "cursor",
    "nested repo",
    "submodule",
    "chinese",
    "中文",
    "scm",
    "git workflow",
    "git history",
    "code review",
    "blame"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "git-brains-panel",
          "title": "JetGit",
          "icon": "$(git-branch)"
        }
      ],
      "activitybar": [
        {
          "id": "git-brains-commit",
          "title": "%viewsContainers.activitybar.git-brains-commit.title%",
          "icon": "images/commit-icon.svg"
        }
      ]
    },
    "views": {
      "git-brains-panel": [
        {
          "type": "webview",
          "id": "git-brains.gitLog",
          "name": "%views.git-brains.gitLog.name%"
        }
      ],
      "git-brains-commit": [
        {
          "type": "webview",
          "id": "git-brains.commitPanel",
          "name": "%views.git-brains.commitPanel.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "git-brains.refreshLog",
        "title": "%command.git-brains.refreshLog.title%",
        "icon": "$(refresh)",
        "category": "JetGit"
      },
      {
        "command": "git-brains.openMergeEditor",
        "title": "%command.git-brains.openMergeEditor.title%",
        "category": "JetGit"
      },
      {
        "command": "git-brains.openConflicts",
        "title": "%command.git-brains.openConflicts.title%",
        "icon": "$(git-merge)",
        "category": "JetGit"
      },
      {
        "command": "git-brains.openMergeEditorFromSCM",
        "title": "%command.git-brains.openMergeEditorFromSCM.title%",
        "icon": "$(git-merge)",
        "category": "JetGit"
      },
      {
        "command": "git-brains.showFileHistory",
        "title": "%command.git-brains.showFileHistory.title%",
        "icon": "$(history)",
        "category": "JetGit"
      },
      {
        "command": "git-brains.nextDiff",
        "title": "%command.git-brains.nextDiff.title%",
        "icon": "$(arrow-down)",
        "category": "JetGit"
      },
      {
        "command": "git-brains.prevDiff",
        "title": "%command.git-brains.prevDiff.title%",
        "icon": "$(arrow-up)",
        "category": "JetGit"
      },
      {
        "command": "git-brains.commitPanel.refresh",
        "title": "%command.git-brains.commitPanel.refresh.title%",
        "icon": "$(refresh)",
        "category": "JetGit"
      },
      {
        "command": "git-brains.commitPanel.commit",
        "title": "%command.git-brains.commitPanel.commit.title%",
        "icon": "$(check)",
        "category": "JetGit"
      },
      {
        "command": "git-brains.commitPanel.commitAndPush",
        "title": "%command.git-brains.commitPanel.commitAndPush.title%",
        "icon": "$(cloud-upload)",
        "category": "JetGit"
      },
      {
        "command": "git-brains.commitPanel.shelve",
        "title": "%command.git-brains.commitPanel.shelve.title%",
        "icon": "$(archive)",
        "category": "JetGit"
      },
      {
        "command": "git-brains.commitPanel.unshelve",
        "title": "%command.git-brains.commitPanel.unshelve.title%",
        "icon": "$(package)",
        "category": "JetGit"
      },
      {
        "command": "git-brains.openPushPanel",
        "title": "%command.git-brains.openPushPanel.title%",
        "icon": "$(cloud-upload)",
        "category": "JetGit"
      },
      {
        "command": "git-brains.editSource",
        "title": "%command.git-brains.editSource.title%",
        "icon": "$(go-to-file)",
        "category": "JetGit"
      },
      {
        "command": "git-brains.showBlameCommit",
        "title": "%command.git-brains.showBlameCommit.title%",
        "category": "JetGit"
      }
    ],
    "menus": {
      "view/title": [],
      "scm/title": [
        {
          "command": "git-brains.openConflicts",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "git-brains.openMergeEditorFromSCM",
          "when": "scmProvider == git && scmResourceGroup == merge",
          "group": "inline@10"
        }
      ],
      "editor/context": [
        {
          "command": "git-brains.showFileHistory",
          "when": "editorTextFocus",
          "group": "git@1"
        },
        {
          "command": "git-brains.editSource",
          "when": "isInDiffEditor && resourceScheme != file",
          "group": "git@2"
        }
      ],
      "explorer/context": [
        {
          "command": "git-brains.showFileHistory",
          "when": "!explorerResourceIsFolder",
          "group": "git@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "git-brains.openPushPanel",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k"
      },
      {
        "command": "git-brains.nextDiff",
        "key": "ctrl+f7",
        "mac": "cmd+f7",
        "when": "editorFocus"
      },
      {
        "command": "git-brains.prevDiff",
        "key": "ctrl+shift+f7",
        "mac": "cmd+shift+f7",
        "when": "editorFocus"
      }
    ],
    "configuration": {
      "title": "JetGit",
      "properties": {
        "git-brains.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-cn"
          ],
          "enumDescriptions": [
            "Follow VS Code display language (default)",
            "English",
            "简体中文"
          ],
          "default": "auto",
          "description": "Language for JetGit UI text. 'auto' follows VS Code display language, falling back to English if unavailable."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:webview": "cd webview && pnpm run watch",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "vsce:package": "pnpm run package && pnpm run build:web && vsce package --no-dependencies",
    "vsce:publish": "pnpm run package && pnpm run build:web && vsce publish --no-dependencies",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "biome check src webview/src",
    "test": "vscode-test",
    "build:web": "cd webview && pnpm run build",
    "build": "pnpm run compile && pnpm run build:web",
    "dev:web": "cd webview && pnpm run dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.18.2+sha512.9fb969fa749b3ade6035e0f109f0b8a60b5d08a1a87fdf72e337da90dcc93336e2280ca4e44f2358a649b83c17959e9993e777c2080879f3801e6f0d999ad3dd",
  "dependencies": {
    "node-diff3": "^3.2.0"
  },
  "author": {
    "name": "ziop",
    "email": "wangpi26@qq.com"
  },
  "homepage": "https://github.com/wangpi26/jetbrains-git-graph",
  "bugs": {
    "url": "https://github.com/wangpi26/jetbrains-git-graph/issues"
  },
  "preview": true
}
